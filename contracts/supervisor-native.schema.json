{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "source": {
    "repository": "EPOCHDevs/EpochAI",
    "commit": "02444690d4daaa0de08ba94a337bbf8fb184b4f0",
    "files": [
      {
        "path": "agent_src/presentation/questions.py",
        "sha256": "e09c41aaad1f0a1f0f9de259e942db3cd0c9faa96e6132cb6aee338ba42ba323"
      },
      {
        "path": "agent_src/common/ask_user.py",
        "sha256": "f2d9e9283c251f5f46d107dd8d7fb81830d5f1da1c15c3c6060ad8c16095d304"
      }
    ]
  },
  "schemas": {
    "AskUser": {
      "$defs": {
        "QuestionOptionWire": {
          "properties": {
            "label": {
              "title": "Label",
              "type": "string"
            },
            "recommended": {
              "title": "Recommended",
              "type": "boolean"
            },
            "description": {
              "title": "Description",
              "type": "string"
            }
          },
          "required": [
            "label",
            "recommended"
          ],
          "title": "QuestionOptionWire",
          "type": "object"
        },
        "QuestionWire": {
          "properties": {
            "question": {
              "title": "Question",
              "type": "string"
            },
            "description": {
              "title": "Description",
              "type": "string"
            },
            "options": {
              "items": {
                "$ref": "#/$defs/QuestionOptionWire"
              },
              "title": "Options",
              "type": "array"
            },
            "multi_select": {
              "title": "Multi Select",
              "type": "boolean"
            }
          },
          "required": [
            "question",
            "description",
            "options",
            "multi_select"
          ],
          "title": "QuestionWire",
          "type": "object"
        }
      },
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "briefing": {
          "title": "Briefing",
          "type": "string"
        },
        "type": {
          "const": "ask_user",
          "title": "Type",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/QuestionWire"
          },
          "title": "Questions",
          "type": "array"
        },
        "tool_call_id": {
          "title": "Tool Call Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "questions",
        "tool_call_id"
      ],
      "title": "AskUserInterruptPayload",
      "type": "object"
    },
    "Answers": {
      "$defs": {
        "UserAnswer": {
          "additionalProperties": false,
          "description": "A user's answer to a question.",
          "properties": {
            "question_index": {
              "title": "Question Index",
              "type": "integer"
            },
            "selected_indices": {
              "items": {
                "type": "integer"
              },
              "title": "Selected Indices",
              "type": "array"
            },
            "free_form_input": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Free Form Input"
            }
          },
          "required": [
            "question_index"
          ],
          "title": "UserAnswer",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Response containing user answers.",
      "properties": {
        "answers": {
          "items": {
            "$ref": "#/$defs/UserAnswer"
          },
          "title": "Answers",
          "type": "array"
        }
      },
      "required": [
        "answers"
      ],
      "title": "AskUserResponse",
      "type": "object"
    }
  }
