{
  "$defs": {
    "NativeUIMessage": {
      "additionalProperties": false,
      "description": "Source envelope: langgraph.graph.ui.UIMessage.\n\nComponent names/props and metadata extensions are deliberately service-owned\nextension points, as in Portal's UIMessage registry. They remain JSON here;\nSDK session events themselves have closed, validated outer shapes.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "research-workflow.schema.json#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "props": {
          "additionalProperties": {
            "$ref": "research-workflow.schema.json#/$defs/JsonValue"
          },
          "title": "Props",
          "type": "object"
        },
        "type": {
          "const": "ui",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "name",
        "props"
      ],
      "title": "NativeUIMessage",
      "type": "object"
    },
    "ProgressResponse": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "title": "ProgressResponse",
      "type": "object"
    },
    "ResearchProgress": {
      "description": "A stable step of the research, unlike UI messages, which follow the Terminal (ENG-2513).\n\n``kind`` is step_started or step_completed (each with a label) around the\nbuild and run steps, study_saved (study_id), execution_started\n(execution_id) or answer_saved (response). A step that fails has no\nstep_completed. The kinds and fields may grow: ignore kinds you don't know.\nFields a newer service adds are ignored rather than refused.",
      "properties": {
        "execution_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Id"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgressResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "study_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Study Id"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ResearchProgress",
      "type": "object"
    },
    "SessionCompleted": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "completed",
          "title": "Event",
          "type": "string"
        },
        "result": {
          "$ref": "research-workflow.schema.json#/$defs/ResearchCompleted"
        }
      },
      "required": [
        "event",
        "result"
      ],
      "title": "SessionCompleted",
      "type": "object"
    },
    "SessionProgress": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "progress",
          "title": "Event",
          "type": "string"
        },
        "handle": {
          "$ref": "research-workflow.schema.json#/$defs/WorkflowHandle"
        },
        "progress": {
          "$ref": "#/$defs/ResearchProgress"
        }
      },
      "required": [
        "event",
        "handle",
        "progress"
      ],
      "title": "SessionProgress",
      "type": "object"
    },
    "SessionQuestions": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "questions",
          "title": "Event",
          "type": "string"
        },
        "waiting": {
          "$ref": "research-workflow.schema.json#/$defs/NeedsInput"
        }
      },
      "required": [
        "event",
        "waiting"
      ],
      "title": "SessionQuestions",
      "type": "object"
    },
    "SessionStatus": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "status",
          "title": "Event",
          "type": "string"
        },
        "handle": {
          "anyOf": [
            {
              "$ref": "research-workflow.schema.json#/$defs/WorkflowHandle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "in_progress"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "event",
        "operation_id",
        "status"
      ],
      "title": "SessionStatus",
      "type": "object"
    },
    "SessionUI": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "ui",
          "title": "Event",
          "type": "string"
        },
        "handle": {
          "$ref": "research-workflow.schema.json#/$defs/WorkflowHandle"
        },
        "message": {
          "$ref": "#/$defs/NativeUIMessage"
        }
      },
      "required": [
        "event",
        "handle",
        "message"
      ],
      "title": "SessionUI",
      "type": "object"
    },
    "SessionUIRemoved": {
      "additionalProperties": false,
      "properties": {
        "event": {
          "const": "ui_removed",
          "title": "Event",
          "type": "string"
        },
        "handle": {
          "$ref": "research-workflow.schema.json#/$defs/WorkflowHandle"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "event",
        "handle",
        "id"
      ],
      "title": "SessionUIRemoved",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "completed": "#/$defs/SessionCompleted",
      "progress": "#/$defs/SessionProgress",
      "questions": "#/$defs/SessionQuestions",
      "status": "#/$defs/SessionStatus",
      "ui": "#/$defs/SessionUI",
      "ui_removed": "#/$defs/SessionUIRemoved"
    },
    "propertyName": "event"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SessionStatus"
    },
    {
      "$ref": "#/$defs/SessionUI"
    },
    {
      "$ref": "#/$defs/SessionUIRemoved"
    },
    {
      "$ref": "#/$defs/SessionProgress"
    },
    {
      "$ref": "#/$defs/SessionQuestions"
    },
    {
      "$ref": "#/$defs/SessionCompleted"
    }
  ]
}
