              "name",
              "digest",
              "saved_at",
              "family",
              "producer_execution_id",
              "producer_definition_id",
              "producer_fit_name",
              "producer_config_sha256"
            ],
            "additionalProperties": false
          },
          "artifact": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "key",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "producer": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "key",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "owner_user_id",
          "model",
          "artifact",
          "producer"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "message",
          "timestamp"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/models": {
      "post": {
        "operationId": "saveModel",
        "description": "Explicitly save one exact completed fit. request_id is owner-scoped: repeat it with identical facts after an uncertain response. Different facts conflict. The successful response is durable readiness after exact artifact/provenance copies; pending attempts remain outside the catalogue. No fitting or numerical execution occurs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveModelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The exact saved model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedModelSummary"
                }
              }
            }
          },
          "400": {
            "description": "Ordinary Platform error envelope; unavailable storage is never absence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Ordinary Platform error envelope; unavailable storage is never absence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Ordinary Platform error envelope; unavailable storage is never absence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Ordinary Platform error envelope; unavailable storage is never absence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Ordinary Platform error envelope; unavailable storage is never absence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Ordinary Platform error envelope; unavailable storage is never absence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Ordinary Platform error envelope; unavailable storage is never absence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listModels",
        "description": "A bounded page of explicitly saved, ready models, including those without folder placements. Cursors bind the authenticated owner.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "default": ""
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved models",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedModelPage"
                }
              }
            }
          },
          "400": {
            "description": "Ordinary Platform error envelope; unavailable storage is never absence",
