    },
    "/api/v1/models/complete": {
      "post": {
        "operationId": "completeModelSaves",
        "description": "Complete only explicit save_as intents from an owned completed native producer descriptor. Equal retries select the same saved identities. This never fits a model or saves unselected temporary fits. source_location=server explicitly selects the configured server export bridge with the caller credential.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteModelSavesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Models explicitly requested by the producer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedModelPage"
                }
              }
            }
          },
          "400": {
