{
  "openapi": "3.1.0",
  "info": {
    "title": "Epoch saved models",
    "version": "1",
    "description": "Platform-owned immutable saved models. Native fitting alone does not save a library resource. Cloud Save reads the exact Completed generation and native artifact directly from shared storage, without Backend HTTP. See docs/contracts/saved-models.md."
  },
  "x-epoch-contract-owner": "EpochPlatform",
  "security": [
    {
      "user": []
    }
  ],
  "components": {
    "securitySchemes": {
      "user": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "SaveModelRequest": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "execution_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "fit_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "expected_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source_location": {
            "type": "string",
            "enum": [
              "shared_personal_v1",
              "server"
            ]
          }
        },
        "required": [
          "request_id",
          "name",
          "execution_id",
          "fit_name",
          "expected_digest"
        ],
        "additionalProperties": false
      },
      "CompleteModelSavesRequest": {
        "type": "object",
        "properties": {
          "execution_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_location": {
            "type": "string",
            "enum": [
              "shared_personal_v1",
              "server"
            ]
          }
        },
        "required": [
          "execution_id"
        ],
        "additionalProperties": false
      },
      "SavedModelSummary": {
        "type": "object",
        "properties": {
          "model_ref": {
            "type": "string",
            "pattern": "^model_[0-9a-f]{64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "saved_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "family": {
            "type": "string"
          },
          "producer_execution_id": {
            "type": "string"
          },
          "producer_definition_id": {
            "type": "string"
          },
          "producer_fit_name": {
            "type": "string"
          },
          "producer_config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "model_ref",
          "name",
          "digest",
          "saved_at",
          "family",
          "producer_execution_id",
          "producer_definition_id",
          "producer_fit_name",
          "producer_config_sha256",
          "manifest_sha256"
        ],
        "additionalProperties": false
      },
      "SavedModelPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "model_ref": {
                  "type": "string",
                  "pattern": "^model_[0-9a-f]{64}$"
                },
