                  "maximum": 9007199254740991
                },
                "family": {
                  "type": "string"
                },
                "producer_execution_id": {
                  "type": "string"
                },
                "producer_definition_id": {
                  "type": "string"
                },
                "producer_fit_name": {
                  "type": "string"
                },
                "producer_config_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "manifest_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "model_ref",
                "name",
                "digest",
                "saved_at",
                "family",
                "producer_execution_id",
                "producer_definition_id",
                "producer_fit_name",
                "producer_config_sha256",
                "manifest_sha256"
              ],
              "additionalProperties": false
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "SavedModelFacts": {
        "type": "object",
