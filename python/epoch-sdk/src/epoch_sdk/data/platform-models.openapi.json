      "SavedModelManifest": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "number",
            "const": 1
          },
          "owner_user_id": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "object",
            "properties": {
              "model_ref": {
                "type": "string",
                "pattern": "^model_[0-9a-f]{64}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "digest": {
                "type": "string",
