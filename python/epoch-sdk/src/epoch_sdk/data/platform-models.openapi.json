    "/api/v1/models/{model_ref}": {
      "parameters": [
        {
          "name": "model_ref",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^model_[0-9a-f]{64}$"
          }
        }
      ],
      "get": {
        "operationId": "readModel",
        "description": "Reauthorizes and verifies an immutable saved model and returns its native facts and pinned public producer script. Read-only: no AI, fit, execution or mutable-source fallback.",
        "responses": {
          "200": {
            "description": "Exact saved facts and script",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedModelFacts"
                }
              }
            }
          },
          "400": {
            "description": "Ordinary Platform error envelope; unavailable storage is never absence",
