                "maximum": 9007199254740991
              },
              "family": {
                "type": "string"
              },
              "producer_execution_id": {
                "type": "string"
              },
              "producer_definition_id": {
                "type": "string"
              },
              "producer_fit_name": {
                "type": "string"
              },
              "producer_config_sha256": {
                "type": "string",
