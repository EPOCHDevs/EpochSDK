{
  "name": "@epochdevs/epoch-sdk",
  "version": "0.1.0-alpha.19",
  "description": "Typed Epoch research workflows over the native StratifyX and LangGraph clients",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./api": {
      "types": "./api.d.ts",
      "import": "./api.js"
    },
    "./files": {
      "types": "./files.d.ts",
      "import": "./files.js"
    },
    "./identity": {
      "types": "./identity.d.ts",
      "import": "./identity.js"
    },
    "./discovery-presentation": {
      "types": "./discovery-presentation.d.ts",
      "import": "./discovery-presentation.js"
    },
    "./discovery": {
      "types": "./discovery.d.ts",
      "import": "./discovery.js"
    },
    "./files-api": {
      "types": "./files-api/index.d.ts",
      "default": "./files-api/index.js"
    },
    "./files-api/core/fetcher": {
      "types": "./files-api/core/fetcher/index.d.ts",
      "default": "./files-api/core/fetcher/index.js"
    },
    "./shares-api": {
      "types": "./shares-api/index.d.ts",
      "default": "./shares-api/index.js"
    },
    "./shares-api/core/fetcher": {
      "types": "./shares-api/core/fetcher/index.d.ts",
      "default": "./shares-api/core/fetcher/index.js"
    },
    "./models-api": {
      "types": "./models-api/index.d.ts",
      "default": "./models-api/index.js"
    },
    "./models-api/core/fetcher": {
      "types": "./models-api/core/fetcher/index.d.ts",
      "default": "./models-api/core/fetcher/index.js"
    }
  },
  "files": [
    "*.js",
    "*.d.ts",
    "schemas.generated.json",
    "README.md",
    "dataset-review.schema.json",
    "platform-files.openapi.json",
    "discovery.schema.json",
    "asset-identity.schema.json",
    "discovery-presentation.schema.json",
    "files-api/",
    "platform-shares.openapi.json",
    "shares-api/",
    "platform-models.openapi.json",
    "models-api/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "generate:discovery": "node generate-discovery.mjs",
    "test:shares-types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext test/types/shares-api.ts",
    "test:models-types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext test/types/models-api.ts"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "form-data": "^4.0.0",
    "js-base64": "^3.7.7",
    "node-fetch": "^2.7.0",
    "qs": "^6.11.2",
    "url-join": "^4.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EPOCHDevs/EpochSDK.git",
    "directory": "typescript/epoch-sdk"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "json-schema-to-typescript": "15.0.4",
    "typescript": "6.0.3"
  }
}
