{
  "name": "@epochdevs/epoch-sdk",
  "version": "0.1.0-alpha.7",
  "description": "Typed Epoch research workflows over the native StratifyX and LangGraph clients",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./api": {
      "types": "./api.d.ts",
      "import": "./api.js"
    }
  },
  "files": [
    "*.js",
    "*.d.ts",
    "schemas.generated.json",
    "README.md",
    "dataset-review.schema.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EPOCHDevs/EpochSDK"
  }
}
