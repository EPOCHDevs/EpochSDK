  "peerDependencies": {
    "@epoch/stratifyx": ">=3.3.0-rc.44 <4",
    "@langchain/langgraph-sdk": ">=1.12.1 <2"
  },
  "engines": { "node": ">=24" },
  "repository": { "type": "git", "url": "https://github.com/EPOCHDevs/EpochSDK" }
