{
  "openapi": "3.1.0",
  "info": {
    "title": "Final presentation source-ready delivery",
    "version": "2"
  },
  "x-epoch-contract-owner": "EpochPlatform",
  "components": {
    "schemas": {
      "FinalPresentationDeliveryRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "execution_category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expected_source": {
            "$ref": "#/components/schemas/FinalPresentationSource"
          },
          "retained_reference": {
            "$ref": "#/components/schemas/FinalPresentationReference"
          },
          "max_expires_epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "execution_category"
        ],
        "additionalProperties": false
      },
      "FinalPresentationDelivery": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "number",
            "const": 2
          },
          "source": {
            "$ref": "#/components/schemas/FinalPresentationSource"
          },
          "retention": {
            "$ref": "#/components/schemas/FinalPresentationRetention"
          },
          "content": {
            "$ref": "#/components/schemas/FinalPresentationRawContent"
          },
          "expires_epoch": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "artifacts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FinalPresentationArtifactAccess"
            }
          },
          "response_tables": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FinalPresentationResponseTableAccess"
            }
          }
        },
        "required": [
          "schema_version",
          "source",
          "retention",
          "content",
          "expires_epoch",
          "artifacts",
          "response_tables"
        ],
        "additionalProperties": false
      },
      "FinalPresentationSource": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "execution_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "definition_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "execution_category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "generation_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "schema_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "prose_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "run_output_manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "response_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "execution_id",
          "definition_id",
          "execution_category",
          "config_sha256",
          "generation_sha256",
          "schema_sha256",
          "prose_sha256",
          "run_output_manifest_sha256"
        ],
        "additionalProperties": false
      },
      "FinalPresentationReference": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "execution_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,128}$"
          },
          "publication_id": {
            "type": "string",
            "pattern": "^pub_[a-f0-9]{64}$"
          },
          "catalog_revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "edit_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "execution_id",
          "publication_id",
          "catalog_revision",
          "edit_version"
        ],
        "additionalProperties": false
      },
      "FinalPresentationRawContent": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "dashboard_json": {
            "type": "string"
          },
          "canonical_prose_json": {
            "type": "string"
          },
          "response_json": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "dashboard_json",
          "canonical_prose_json",
          "response_json"
        ],
        "additionalProperties": false
      },
      "FinalPresentationRetention": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/FinalPresentationRetentionPending"
          },
          {
            "$ref": "#/components/schemas/FinalPresentationRetentionRetained"
          }
        ],
        "discriminator": {
          "propertyName": "state",
          "mapping": {
            "pending": "#/components/schemas/FinalPresentationRetentionPending",
            "retained": "#/components/schemas/FinalPresentationRetentionRetained"
          }
        }
      },
      "FinalPresentationRetentionPending": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "const": "pending"
          }
        },
        "required": [
          "state"
        ],
        "additionalProperties": false
      },
      "FinalPresentationRetentionRetained": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "const": "retained"
          },
          "reference": {
            "$ref": "#/components/schemas/FinalPresentationReference"
          }
        },
        "required": [
          "state",
          "reference"
        ],
        "additionalProperties": false
      },
      "FinalPresentationArtifactAccess": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "data_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "category",
          "data_id",
          "bytes",
          "url"
        ],
        "additionalProperties": false
      },
      "FinalPresentationResponsePartAccess": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "sha256",
          "offset",
          "rows",
          "bytes",
          "url"
        ],
        "additionalProperties": false
      },
      "FinalPresentationResponseTableAccess": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "table_id": {
            "type": "string",
            "pattern": "^rqt_[a-f0-9]{64}$"
          },
          "execution_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "query_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "schema_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "field_ids": {
            "minItems": 1,
            "maxItems": 1024,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/FinalPresentationResponsePartAccess"
            }
          }
        },
        "required": [
          "table_id",
          "execution_id",
          "query_name",
          "schema_sha256",
          "row_count",
          "field_ids",
          "parts"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "message",
          "timestamp"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "ownerBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/v1/contexts/executions/{executionId}/presentation/delivery": {
      "post": {
        "operationId": "readFinalPresentationDelivery",
        "description": "Exact final raw documents and original Arrow access; pending or accepted permanent retention. Never executes or calls a model.",
        "security": [
          {
            "ownerBearer": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "executionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinalPresentationDeliveryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Final content stays opaque until a verified lossless domain codec",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalPresentationDelivery"
                }
              }
            }
          },
          "400": {
            "description": "Explicit refusal/unavailability; no source replacement or recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Explicit refusal/unavailability; no source replacement or recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Explicit refusal/unavailability; no source replacement or recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Explicit refusal/unavailability; no source replacement or recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Explicit refusal/unavailability; no source replacement or recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Explicit refusal/unavailability; no source replacement or recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Explicit refusal/unavailability; no source replacement or recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "425": {
            "description": "Final content/objects pending; Retry-After: 1",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds before retrying the same final delivery read, never a new execution",
                "schema": {
                  "type": "integer",
                  "enum": [
                    1
                  ],
                  "minimum": 1,
                  "maximum": 1
                }
              }
            }
          },
          "503": {
            "description": "Explicit refusal/unavailability; no source replacement or recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Explicit refusal/unavailability; no source replacement or recomputation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
